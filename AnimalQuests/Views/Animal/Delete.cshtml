@model testing.Models.Animal

@{
    ViewData["Title"] = "Usuń zwierzę";
}

<h1>@ViewData["Title"]</h1>

<p>Usuwasz zwierzę "@Model.Name" na własną odpowiedzialność! Jeśli po tej akcji nasza baza danych wyleci w powietrze, to twoja wina.</p>
<p>Poza tym reszta będzie tęsknić.</p>
<p>Czy na pewno chcesz usunąć to zwierzę?</p>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Usuń</button>
    <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
</form>
