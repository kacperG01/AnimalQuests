@model testing.Models.Biome

@{
    ViewData["Title"] = "Usuń biom";
}

<h1>@ViewData["Title"]</h1>

<p>Usuwasz biom "@Model.Name" na własną odpowiedzialność! Jeśli po tej akcji nasza baza danych wyleci w powietrze, to twoja wina.</p>
<p>Czy na pewno chcesz usunąć ten biom?</p>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    <button type="submit" class="btn btn-danger">Usuń</button>
    <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
</form>
