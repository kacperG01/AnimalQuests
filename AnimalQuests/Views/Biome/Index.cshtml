@model List<AnimalQuests.Models.Biome>

@{
    ViewData["Title"] = "Biomy";
}
<h1>@ViewData["Title"]</h1>

@if (Model.Count == 0)
{
    <p>Brak biomów w bazie danych.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nazwa</th>
                <th>Mieszkańcy</th>
                <th>Akcje</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var biome in Model)
            {
                <tr>
                    <td>@biome.Name</td>
                    <td>
                        @if (biome.Animals.Count == 0)
                        {
                            <span></span>
                        } 
                        else
                        {
                            <ul>
                            @foreach (var animal in biome.Animals)
                            {
                                <li>@animal.Species @animal.Name</li>
                            }
                            </ul>
                        }
                    </td>
                    <td>
                        <a asp-action="AnimalList"
                           asp-route-id="@biome.Id"
                           class="btn btn-sm btn-primary">
                            Lista mieszkańców
                        </a>
                        
                        <a asp-action="Edit"
                           asp-route-id="@biome.Id"
                           class="btn btn-sm btn-warning">
                            Edytuj
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@biome.Id"
                           class="btn btn-sm btn-danger">
                            Usuń
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

<a asp-controller="Biome"
   asp-action="Create"
   class="btn btn-primary mb-3">
    Dodaj biom
</a>