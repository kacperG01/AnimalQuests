@model List<AnimalQuests.Models.Mission>

@{
    ViewData["Title"] = "Lista misji";
}

<h1>Lista misji</h1>

@if (Model.Count == 0)
{
    <p>Brak misji w bazie danych.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Cel misji</th>
                <th>Biom</th>
                <th>Akcje</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var mission in Model)
            {
                <tr>
                    <td>@mission.Id</td>
                    <td>@mission.Objective</td>
                    <td>@mission.AssignedBiome.Name</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@mission.Id"
                           class="btn btn-sm btn-warning">
                            Edytuj
                        </a>
                        <a asp-controller="Mission"
                           asp-action="Details"
                           asp-route-id="@mission.Id"
                           class="btn btn-primary">
                            Szczegóły
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

}
<a asp-action="Create" class="btn btn-success mb-3">
    Utwórz misję
</a>